{
  "name": "identity-building-os",
  "version": "1.0.0",
  "description": "A calm, visual personal system for becoming who you want to be — based on Atomic Habits by James Clear",
  "main": "main.js",
  "author": "Identity OS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "electron:start": "electron .",
    "py:server": "python app.py",
    "setup:python": "powershell -ExecutionPolicy Bypass -File scripts/setup_python_runtime.ps1",
    "prepack": "npm run setup:python",
    "pack": "electron-builder --dir",
    "predist": "npm run setup:python",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.identityos.app",
    "productName": "Identity Building OS",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "app.py",
      "static/**/*",
      "guidance/**/*",
      "python-runtime/**/*",
      ".env",
      ".env.example"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Identity Building OS"
    }
  }
}
