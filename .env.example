# Identity Building OS Configuration
# Copy this file to .env to customize local configuration.

# Network Configuration
IDENTITY_OS_HOST=127.0.0.1
PORT=8765

# File Paths (relative to application root or absolute)
IDENTITY_OS_DB_PATH=data/identity_os.db
IDENTITY_OS_GUIDANCE_DIR=guidance
IDENTITY_OS_STATIC_DIR=static

# Logging (set to 1 to enable verbose HTTP access logs)
IDENTITY_OS_VERBOSE=0
